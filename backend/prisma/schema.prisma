datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Phân quyền người dùng trong hệ thống
enum Role {
  ADMIN
  COMPANY_MANAGER
  RECRUITER
  INTERVIEWER
  CANDIDATE
}

// 2. Các trạng thái trong vòng đời tuyển dụng (Phục vụ Kanban Board)
enum ProcessStage {
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL_TEST
  OFFER
  HIRED
  REJECTED
}

// 3. Bảng quản lý tài khoản đăng nhập
model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  role             Role              @default(CANDIDATE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
}

// 4. Bảng thông tin công ty tuyển dụng
model Company {
  id                String             @id @default(uuid())
  name              String
  website           String?
  logo              String?
  description       String?
  createdAt         DateTime           @default(now())
  recruiterProfiles RecruiterProfile[]
  jobs              Job[]
}

// 5. Bảng hồ sơ riêng của Recruiter
model RecruiterProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  fullName  String
  createdAt DateTime @default(now())
}

// 6. Bảng hồ sơ ứng viên (Nơi lưu dữ liệu sau khi AI Parsing)
model CandidateProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String?
  avatar       String?
  skills       String[] // Mảng lưu danh sách kỹ năng trích xuất từ CV
  experience   Json? // Lưu cấu trúc mảng kinh nghiệm làm việc dạng JSON
  education    Json? // Lưu cấu trúc học vấn dạng JSON
  resumeUrl    String? // Đường dẫn file CV gốc (PDF/Docx) lưu trên Cloud
  createdAt    DateTime      @default(now())
  applications Application[]
}

// 7. Bảng quản lý tin tuyển dụng (Job Description - JD)
model Job {
  id           String        @id @default(uuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  title        String
  description  String // Nội dung chi tiết công việc
  requirements String // Yêu cầu kỹ năng, kinh nghiệm từ doanh nghiệp
  salaryRange  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  applications Application[]
}

// 8. Bảng quản lý đơn ứng tuyển & Điểm số AI Ranking
model Application {
  id               String           @id @default(uuid())
  jobId            String
  job              Job              @relation(fields: [jobId], references: [id])
  candidateId      String
  candidateProfile CandidateProfile @relation(fields: [candidateId], references: [id])
  stage            ProcessStage     @default(APPLIED)

  // Các trường lưu kết quả chấm điểm từ AI Matching
  matchingScore   Float   @default(0.0) // Tổng điểm 0-100
  skillScore      Float   @default(0.0) // Điểm tương thích kỹ năng
  experienceScore Float   @default(0.0) // Điểm tương thích kinh nghiệm
  aiExplanation   String? // Đoạn text AI giải thích lý do chấm điểm

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  interviews Interview[]
}

// 9. Bảng quản lý lịch phỏng vấn & AI Phân tích cuộc hội thoại
model Interview {
  id              String      @id @default(uuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  interviewerName String

  // Dữ liệu phục vụ AI Interview Analysis
  transcript     String? // Nội dung text cuộc phỏng vấn (Interviewer gõ hoặc import)
  sentimentScore Float? // Điểm thái độ/tâm lý ứng viên (Thang điểm 0-1)
  summary        String? // AI tóm tắt ngắn gọn nhận xét cốt lõi

  createdAt DateTime @default(now())
}
