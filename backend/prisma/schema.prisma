datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Cổng 6543 có đuôi ?pgbouncer=true
  directUrl = env("DIRECT_URL") // Cổng 5432 để đục tường chạy trực tiếp
}

generator client {
  provider = "prisma-client-js"
}

// 1. Phân quyền người dùng trong hệ thống (Đổi tên thành UserRole để khớp code Auth)
enum UserRole {
  ADMIN
  COMPANY_MANAGER
  RECRUITER
  INTERVIEWER
  CANDIDATE
}

// 2. Các trạng thái trong vòng đời tuyển dụng (Phục vụ Kanban Board)
enum ProcessStage {
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL_TEST
  OFFER
  HIRED
  REJECTED
}

// 3. Bảng quản lý tài khoản đăng nhập
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CANDIDATE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Thông tin cá nhân cơ bản (Dùng chung cho tất cả các vai trò tránh tạo quá nhiều bảng Profile lẻ)
  fullName String?
  phone    String?
  avatar   String?

  // Kết nối đến các vai trò đặc thù
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?

  // Danh sách các Job do User này đăng (Nếu là Admin/Recruiter/Manager)
  postedJobs Job[]
}

// 4. Bảng thông tin công ty tuyển dụng
model Company {
  id                String             @id @default(uuid())
  name              String
  website           String?
  logo              String?
  description       String?
  createdAt         DateTime           @default(now())
  recruiterProfiles RecruiterProfile[]
  jobs              Job[]
}

// 5. Bảng hồ sơ riêng của Recruiter/Manager để liên kết với Công ty
model RecruiterProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// 6. Bảng hồ sơ ứng viên (Nơi lưu dữ liệu nâng cao + kết quả AI Parsing)
model CandidateProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       String[] // Mảng lưu danh sách kỹ năng trích xuất từ CV
  experience   Json? // Lưu cấu trúc mảng kinh nghiệm làm việc dạng JSON
  education    Json? // Lưu cấu trúc học vấn dạng JSON
  resumeUrl    String? // Đường dẫn file CV gốc (PDF/Docx) lưu trên Cloud
  createdAt    DateTime      @default(now())
  applications Application[]
}

// 7. Bảng quản lý tin tuyển dụng (Job Description - JD)
model Job {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Thêm liên kết trực tiếp với người đăng tin để dễ quản lý phân quyền
  recruiterId String
  recruiter   User   @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  title        String
  description  String // Nội dung chi tiết công việc
  requirements String // Yêu cầu kỹ năng, kinh nghiệm từ doanh nghiệp
  salaryRange  String? // Ví dụ: "15M - 25M"
  location     String // Địa điểm làm việc (Hà Nội, TP.HCM, Remote)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

// 8. Bảng quản lý đơn ứng tuyển & Điểm số AI Ranking
model Application {
  id               String           @id @default(uuid())
  jobId            String
  job              Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId      String
  candidateProfile CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage            ProcessStage     @default(APPLIED)

  // Các trường lưu kết quả chấm điểm từ AI Matching
  matchingScore   Float   @default(0.0) // Tổng điểm 0-100
  skillScore      Float   @default(0.0) // Điểm tương thích kỹ năng
  experienceScore Float   @default(0.0) // Điểm tương thích kinh nghiệm
  aiExplanation   String? // Đoạn text AI giải thích lý do chấm điểm

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  interviews Interview[]
}

// 9. Bảng quản lý lịch phỏng vấn (Đã tinh gọn, chỉ tập trung vào quản lý lịch trình)
model Interview {
  id              String      @id @default(uuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime // Thời gian diễn ra cuộc phỏng vấn
  locationOrLink  String // Địa điểm phỏng vấn (Ví dụ: "Phòng họp 3" hoặc link Zoom/Meet)
  interviewerName String // Tên người sẽ phụ trách phỏng vấn ứng viên

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
